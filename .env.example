TELEGRAM_AUTH_MAX_AGE_SECONDS=300
JWT_TTL_SECONDS=900
LOG_LEVEL=INFO
FRONTEND_PORT=5173
BACKEND_PORT=8000
VITE_API_URL=/api/v1
VITE_BOT_USERNAME=your_bot_username
