APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
BOT_TOKEN=123456:replace-with-real-telegram-bot-token
BOT_USERNAME=TimeTogetherBot
MINI_APP_URL=https://your-ngrok-domain.ngrok-free.dev
DATABASE_URL=postgresql+asyncpg://timetogether:timetogether@postgres:5432/timetogether
REDIS_URL=redis://redis:6379/0
